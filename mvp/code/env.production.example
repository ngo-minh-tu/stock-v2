# Production env template — copy to `.env` on production host and edit values.
# Per Mốc 3 step 3 — DO NOT commit `.env` with real secrets.

# --- App ---
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database ---
# Container: /app/data/screener.db (volume-mounted)
# Bare-metal: absolute path, e.g. /srv/stock-screener/data/screener.db
DB_PATH=/app/data/screener.db
DB_BUSY_TIMEOUT_MS=5000

# --- Auth ---
# CRITICAL: generate via `openssl rand -hex 32` before first deploy. Min 32 chars.
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32_xxxxxxxxxxxxxxxx
JWT_TTL_HOURS=24
INITIAL_USER_EMAIL=admin@example.local
# CRITICAL: change first-boot, then run POST /api/auth/change-password.
INITIAL_USER_PASSWORD=replace_with_strong_initial_admin_password

# --- CORS / FE ---
# Set to the public origin (HTTPS) where the Next.js FE is served from.
FRONTEND_ORIGIN=https://screener.example.com

# --- vnstock ---
# Guest quota = 20 req/min. BCTC = 4 sub-calls/ticker, so per-call gating
# inside `fetch_financials` covers the burst.
VNSTOCK_RATE_LIMIT_S=6.5
VNSTOCK_TIMEOUT_S=10
# Set true to short-circuit vnstock fetches for smoke/E2E flows. Keep false in prod.
VNSTOCK_CLIENT_STUB=false

# --- Telegram (optional — leave empty to disable bot notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PDF ---
# weasyprint (default, native render) | html_mock (HTML-as-PDF fallback)
EXPORT_PDF_MODE=weasyprint
