# --- App ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database ---
# Container: /app/data/screener.db
# Local dev: ./data/screener.db
DB_PATH=./data/screener.db
DB_BUSY_TIMEOUT_MS=5000

# --- Auth ---
JWT_SECRET=change-me-in-prod-min-32-chars-xxxxxxxxxxxxx
JWT_TTL_HOURS=24
INITIAL_USER_EMAIL=admin@example.local
INITIAL_USER_PASSWORD=replace_with_strong_initial_admin_password

# --- CORS / FE ---
FRONTEND_ORIGIN=http://localhost:3000

# --- vnstock ---
# Guest quota observed in Phase 12: 20 requests/minute. Current price fetch can
# consume ~2 upstream requests per ticker, so keep the default conservative.
VNSTOCK_RATE_LIMIT_S=6.5
VNSTOCK_TIMEOUT_S=10
# Set true to short-circuit vnstock fetches (useful for E2E smoke; refresh returns
# empty rows but completes successfully). Default false → real vnstock calls.
VNSTOCK_CLIENT_STUB=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PDF ---
# weasyprint | html_mock
EXPORT_PDF_MODE=weasyprint
