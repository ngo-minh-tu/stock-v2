# --- App ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database ---
# Container: /app/data/screener.db
# Local dev: ./data/screener.db
DB_PATH=./data/screener.db
DB_BUSY_TIMEOUT_MS=5000

# --- Auth ---
JWT_SECRET=change-me-in-prod-min-32-chars-xxxxxxxxxxxxx
JWT_TTL_HOURS=24
INITIAL_USER_EMAIL=admin@local
INITIAL_USER_PASSWORD=ChangeMe123!

# --- CORS / FE ---
FRONTEND_ORIGIN=http://localhost:3000

# --- vnstock ---
VNSTOCK_RATE_LIMIT_S=0.5
VNSTOCK_TIMEOUT_S=10

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PDF ---
# weasyprint | html_mock
EXPORT_PDF_MODE=weasyprint
