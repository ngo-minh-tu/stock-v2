# Copy to .env only when running the stable local demo database.

APP_ENV=demo
APP_VERSION=0.1.0
LOG_LEVEL=INFO

DB_PATH=./data/demo-screener.db
DB_BUSY_TIMEOUT_MS=5000

JWT_SECRET=demo-only-change-before-sharing-xxxxxxxxxxxx
JWT_TTL_HOURS=24
INITIAL_USER_EMAIL=admin@local
INITIAL_USER_PASSWORD=ChangeMe123!

FRONTEND_ORIGIN=http://localhost:3000

VNSTOCK_RATE_LIMIT_S=6.5
VNSTOCK_TIMEOUT_S=10
# Phase 19 — E2E mode: skip real vnstock calls so /refresh/* finishes quickly
# (refresh terminates COMPLETED with empty stats; DB data already seeded by demo_seed).
VNSTOCK_CLIENT_STUB=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

EXPORT_PDF_MODE=weasyprint
